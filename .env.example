# Local development uses SQLite. The Docker stack overrides this with a
# postgresql+psycopg:// URL pointing at the `db` service.
DATABASE_URL=sqlite+aiosqlite:///./memind.db

# Password for the Postgres container in docker-compose.yml. Required by the
# compose stack; ignored when running against SQLite.
POSTGRES_PASSWORD=change-me

OLLAMA_API_BASE=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4-flash
OLLAMA_API_KEY=your-ollama-api-key-here

# Secret used to sign JWTs. Change this in production.
JWT_SECRET_KEY=dev-secret-key-change-in-production

# Session inactivity timeout. The client signs you out after this many quiet
# minutes, warning you WARNING seconds beforehand.
SESSION_IDLE_MINUTES=15
SESSION_IDLE_WARNING_SECONDS=60

# Local Whisper model size for voice transcription. One of:
# tiny, base, small, medium, large-v3. Larger = more accurate but slower;
# weights download on first use (~75MB for tiny, ~150MB for base).
WHISPER_MODEL=base

# Outbound email for password-reset links. Leave SMTP_HOST empty and the link is
# written to the backend log instead of sent.
#
# Gmail: enable 2FA, create an app password, then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=the-16-character-app-password
#   SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Encrypts per-user LLM provider API keys at rest. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes previously stored keys unreadable (they must be re-entered).
SECRET_ENCRYPTION_KEY=
